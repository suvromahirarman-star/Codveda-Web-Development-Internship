# NEXUS Project Management Application - Server Environment Variables Template
# Copy this file to .env and configure your variables before starting the backend.

PORT=5000
# For Local MongoDB: mongodb://127.0.0.1:27017/nexus
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexus?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexus?retryWrites=true&w=majority
# Dedicated Test Database URI (Must point strictly to nexus_test)
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexus_test?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
AUTO_SEED=true

# Reverse Proxy Trust (Set to true or 1 only if deployed behind a trusted reverse proxy like NGINX or Cloudflare)
TRUST_PROXY=false

# Rate Limiting Configuration (Defaults: 15 min window, 300 general reqs, 60 mutation reqs)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_MUTATION_MAX=60
