{
  "name": "nexus-server",
  "version": "1.0.0",
  "description": "NEXUS Project Management Application - Express & MongoDB REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node config/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "nexus",
    "project-management",
    "express",
    "mongodb",
    "mongoose",
    "rest-api"
  ],
  "author": "Suvro Mahir Arman",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
