# User Authentication System - Server Environment Variables Template
# Copy this file to server/.env and fill in your actual credentials.
# server/.env is the CANONICAL environment file and is strictly git-ignored.

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/auth_system?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_high_entropy_jwt_key_min_32_chars
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173
NODE_ENV=development

